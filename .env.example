# PostgreSQL
POSTGRES_DB=geogallery
POSTGRES_USER=geogallery
POSTGRES_PASSWORD=geogallery
POSTGRES_PORT=5432

# MinIO (S3-compatible storage)
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_BUCKET=geogallery
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_LICENSE_PATH=$HOME/minio/minio.license

# Backend
DATABASE_URL=postgres://geogallery:geogallery@localhost:5432/geogallery?sslmode=disable
S3_ENDPOINT=http://localhost:9000
# The S3 base URL presigned media URLs are signed for; browsers must reach it. Unset, S3_ENDPOINT.
# In the root .env for docker compose, it defaults to http://localhost:${MINIO_API_PORT}.
# S3_PUBLIC_ENDPOINT=https://s3.example.com
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=geogallery
S3_REGION=us-east-1
SERVER_PORT=8080
INGEST_WATCH_DIR=../ingest
MIGRATIONS_PATH=./migrations
# The IANA zone camera clocks show. EXIF times carry no usable zone, so a photo is read in this zone
# unless its own GPS timestamp or offset tag says otherwise. Required when PUBLIC_URL is https (the backend refuses to start without it).
# Over http, unset means the server's zone, which is UTC in Docker.
# CAMERA_TIMEZONE=Europe/Warsaw

# Auth (OIDC). Defaults target the dev Keycloak (docker compose --profile dev).
# For a managed provider set OIDC_ISSUER_URL and OIDC_DISCOVERY_URL to the same value.
# Unset, docker compose derives these from FRONTEND_PORT/KEYCLOAK_PORT; config.go defaults match the default ports.
# PUBLIC_URL=http://localhost:5173
# OIDC_ISSUER_URL=http://localhost:8180/realms/geogallery
# Defaults to OIDC_ISSUER_URL natively and to http://keycloak:8080/... in docker compose.
# OIDC_DISCOVERY_URL=
OIDC_CLIENT_ID=geogallery
OIDC_CLIENT_SECRET=geogallery-dev-secret
OIDC_SCOPES=openid profile email
SESSION_TTL_HOURS=720

# Keycloak (dev/E2E IdP, dev profile only, bound to 127.0.0.1)
# Changing KEYCLOAK_PORT or FRONTEND_PORT requires matching redirectUris and
# post.logout.redirect.uris in deploy/keycloak/geogallery-realm.json, and
# PUBLIC_URL/OIDC_ISSUER_URL must match the new ports if set.
KEYCLOAK_PORT=8180
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin

# Frontend
FRONTEND_PORT=5173
