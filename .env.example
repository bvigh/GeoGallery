# PostgreSQL
POSTGRES_DB=geogallery
POSTGRES_USER=geogallery
POSTGRES_PASSWORD=geogallery
POSTGRES_PORT=5432

# MinIO (S3-compatible storage)
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_BUCKET=geogallery
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

# Backend
DATABASE_URL=postgres://geogallery:geogallery@localhost:5432/geogallery?sslmode=disable
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=geogallery
S3_REGION=us-east-1
SERVER_PORT=8080
INGEST_WATCH_DIR=./ingest
MIGRATIONS_PATH=./migrations

# Frontend
FRONTEND_PORT=5173
